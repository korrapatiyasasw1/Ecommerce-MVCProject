@model RegisterDTO

<form asp-action="Register" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>
    <div>
        <label>Role</label>
        <input asp-for="Role" />
    </div>


    <button type="submit">Register</button>

</form>