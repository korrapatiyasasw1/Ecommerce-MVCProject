@model List<Product>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Product List</h2>

        <a asp-action="AddProduct"
           asp-controller="Product"
           class="btn btn-success">
            Add Product
        </a>
    </div>
    <div class="row-mb-3">
        <div class="col-md-6">
    <form  asp-action="Search" asp-controller="Product" method="get" class="d-flex gap-2">
        <input type="text"name="ProductName" />
        <button type="Submit">Search</button>
    </form>
    </div>
    <div class="col-md-6">
    <form asp-action="SearchByCategoryName" asp-controller="Product" method="get"
    class="d-flex gap-2">
        <select name="CategoryName" class="form-select">
            @foreach (var item in ViewBag.Categories)
            {
                <option value="@item.Name">@item.Name</option>
            }
        </select>

        <button type="submit" class="btn btn-primary">
            Filter
        </button>
    </form>
    </div>
    </div>
   
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-2 mb-2">

                <div class="card shadow h-20">

                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height:150px; object-fit:contain;" />

                    <div class="card-body">

                        <h4 class="card-title">@item.Name</h4>

                        <p><strong>Brand:</strong> @item.Brand</p>

                        <p><strong>Category:</strong> @item.Category.Name</p>

                        <p><strong>Price:</strong> ₹@item.Price.ToString("N2")</p>

                        <p><strong>Description:</strong></p>
                        <p>@item.Description</p>

                    </div>


                    <div class="card-footer">

                        <div class="d-grid gap-2">

                            <a asp-action="ProductDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-primary">
                               ProductDetails 
                            </a>

                            <a asp-action="UpdateProduct"
                               asp-route-id="@item.Id"
                               class="btn btn-warning">
                                Edit
                            </a>

                            <a asp-action="DeleteProduct"
                               asp-route-id="@item.Id"
                               class="btn btn-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


</div>