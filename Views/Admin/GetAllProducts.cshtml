@model List<Product>

<h2>All Products</h2>

@if (Model == null || !Model.Any())
{
    <h4>No Products Found</h4>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>₹@item.Price.ToString("N2")</td>
                    <td>@item.stock</td>
                   
                </tr>
            }
        </tbody>
    </table>
}